{
    "manifest_version": 3,
    "name": "NS FIT and IPPT Helper",
    "version": "1.0",
    "description": "Make planning NS FIT and IPPT easier",
    "permissions": ["tabs", "storage"],
    "host_permissions": ["https://www.ns.gov.sg/*"],
    "background": { "service_worker": "background.js" },
    "action": { "default_popup": "popup.html" }
}
